QPushButton#primaryButton:hover, QPushButton#smallPrimaryButton:hover {
    background: #075CCF;
}

QPushButton#primaryButton:disabled, QPushButton#smallPrimaryButton:disabled {
    background: #C5D1DE;
    color: #F7F9FB;
}

QScrollArea#pageScroll {
    background: #F5F5F7;
}

QScrollArea#pageScroll > QWidget > QWidget {
    background: #F5F5F7;
}

/* SCM Control Tower detailed-progress component. */
QLabel#kpiTitle {
    color: #6B6B70;
    font-size: 12px;
    font-weight: 700;
}

QLabel#kpiValue {
    color: #161618;
    font-size: 27px;
    font-weight: 800;
}

QPushButton#FilterButton {
    min-height: 34px;
    padding: 0 14px;
    color: #3B3B40;
    background: #FFFFFF;
    border: 1px solid #D7DCE3;
    border-radius: 9px;
    font-weight: 700;
}

QPushButton#FilterButton:hover {
    background: #F3F7FF;
    border-color: #BFD9FA;
}

QPushButton#FilterButton:checked {
    color: #0A7AFF;
    background: #E8F2FF;
    border: 1px solid #0A7AFF;
}

QComboBox#FilterInput,
QDateEdit#FilterInput,
QComboBox#ProgressStatusFilter {
    min-height: 36px;
    padding: 0 10px;
    color: #1D1D1F;
    background: #FFFFFF;
    border: 1px solid #D2D2D7;
    border-radius: 8px;
}

QComboBox#FilterInput:focus,
QDateEdit#FilterInput:focus,
QComboBox#ProgressStatusFilter:focus {
    border-color: #0A7AFF;
}

QLabel#StatusChip {
    color: #6B6B70;
    background: #FFFFFF;
    border: 1px solid #E7E7EA;
    border-radius: 16px;
    padding: 6px 11px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#StatusChip[status="success"] {
    color: #15803D;
    background: #E8F8EE;
    border-color: #CDEED8;
}

QLabel#StatusChip[status="warning"] {
    color: #D97706;
    background: #FFF4E5;
    border-color: #F8DEB9;
}

QTableView#DataTable {
    background: #FFFFFF;
    alternate-background-color: #FAFAFC;
    border: 1px solid #ECECF0;
    border-radius: 9px;
    gridline-color: #ECECF0;
    selection-background-color: #E8F2FF;
    selection-color: #0A4F9C;
    outline: none;
}

QTableView#DataTable::item {
    padding: 5px 7px;
}

QTableView#DataTable::item:selected {
    color: #0A4F9C;
    background: #E8F2FF;
}
QLabel#LiveBadge {
    color: #07875F;
    background: #E7F8F0;
    border: 1px solid #B8E8D2;
    border-radius: 8px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 800;
}

/* SCM Control Tower selection contrast */
QPushButton#FilterButton:checked,
QPushButton#FilterButton:checked:hover,
QPushButton#FilterButton:checked:focus {
    color: #075CCF;
    background: #E8F2FF;
    border: 1px solid #7DB7FF;
}

QTableView#DataTable::item:selected,
QTableView#DataTable::item:selected:active,
QTableView#DataTable::item:selected:!active {
    color: #075CCF;
    background: #E8F2FF;
}

QComboBox#ProgressStatusFilter QAbstractItemView,
QComboBox#FilterInput QAbstractItemView,
QComboBox#CollectionSchedule QAbstractItemView {
    color: #24344D;
    background: #FFFFFF;
    selection-color: #075CCF;
    selection-background-color: #E8F2FF;
    outline: 0;
}

