}

QScrollArea#SalineRegistrationScroll,
QWidget#SalineRegistrationContainer {
    background: transparent;
    border: 0;
}

QFrame#SalineRegistrationCard {
    background: #FFFFFF;
    border: 1px solid #D7E5E7;
    border-left: 4px solid #11A7A0;
    border-radius: 10px;
}

QFrame#SalineRegistrationCard:hover {
    background: #F5FBFB;
    border-color: #AED8DA;
    border-left-color: #078A85;
}

QLabel#SalineRegistrationCode {
    color: #087B84;
    background: #E1F5F5;
    border: 1px solid #BCE2E3;
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 900;
}

QLabel#SalineRegistrationName {
    color: #17324D;
    font-size: 11px;
    font-weight: 850;
}

QLabel#SalineRegistrationStatus {
    color: #7A8795;
    background: #F0F3F6;
    border: 1px solid #DCE3EA;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 800;
}

QLabel#SalineRegistrationStatus[active="true"] {
    color: #087A55;
    background: #E8F8F1;
    border-color: #BCE8D5;
}

QLabel#SalineRegistrationMeta {
    color: #5F7388;
    background: #F4F7FA;
    border: 1px solid #E0E7EE;
    border-radius: 6px;
    padding: 4px 7px;
    font-size: 8px;
