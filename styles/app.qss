}

QTableWidget#SalineLeadDetailTable {
    background: #FFFFFF;
    border: 1px solid #E1E8F0;
    border-radius: 8px;
    selection-background-color: #DCEBFF;
    selection-color: #0F2742;
}

QTableWidget#SalineLeadDetailTable QHeaderView::section {
    color: #49627D;
    background: #F3F7FB;
    border: 0;
    border-right: 1px solid #E0E8F0;
