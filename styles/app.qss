QFrame#SalineRegistrationEmpty {
    background: #F8FAFC;
    border: 1px dashed #CBD7E3;
    border-radius: 11px;
}

QScrollArea#SalineLeadDetailScroll,
QScrollArea#SalineRegistrationScroll {
    background: transparent;
    border: none;
}

/* 식염수·리드지 조회: Control Tower 기준 우측 열 카드 구획 */
QFrame#SalineLeadRightColumn {
    background: #F4F7FB;
    border: 1px solid #D5DFEA;
    border-radius: 16px;
}

QWidget#SalineLeadDetailContent {
    background: transparent;
}

QFrame#SalineLeadSelectionSummary {
    background: #FFFFFF;
    border: 1px solid #D7E2EE;
    border-radius: 12px;
}

QLabel#SalineLeadSelectionKicker {
    color: #52677E;
    font-size: 11px;
    font-weight: 700;
}

QLabel#SalineLeadDetailHeading {
    color: #10233F;
    font-size: 15px;
    font-weight: 700;
}

QFrame#SalineLeadDetailCard {
    background: #FFFFFF;
    border: 1px solid #D7E2EE;
    border-radius: 14px;
}

QFrame#SalineLeadDetailCard[tone="lead"] {
    border-color: #C8DCF2;
}

QFrame#SalineLeadDetailCard[tone="saline"] {
    border-color: #BFDCD9;
}

QLabel#SalineLeadDetailCount[tone="lead"] {
    background: #EAF3FF;
    color: #0867C9;
    border: 1px solid #C6DCF4;
    border-radius: 9px;
    padding: 3px 8px;
    font-weight: 700;
}

QLabel#SalineLeadDetailCount[tone="saline"] {
    background: #E9F7F5;
    color: #007F86;
    border: 1px solid #BFE2DE;
    border-radius: 9px;
    padding: 3px 8px;
    font-weight: 700;
}

QFrame#SalineLeadMetadataPanel,
QFrame#SalineLeadPdfPreview {
    background: #F8FAFD;
    border: 1px solid #DEE7F0;
    border-radius: 11px;
}

QFrame#SalineLeadMetadataField {
    background: #FFFFFF;
    border: 1px solid #E1E8F0;
    border-radius: 8px;
}

QFrame#SalineRegistrationCard {
    background: #F7FCFB;
    border: 1px solid #CFE5E2;
    border-radius: 10px;
}
