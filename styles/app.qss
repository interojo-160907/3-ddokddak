    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1px;
}

QSplitter#SalineLeadCardSplitter::handle {
    background: #F5F5F7;
    height: 10px;
    border-top: 1px solid #E2E7ED;
    border-bottom: 1px solid #E2E7ED;
