}

QPushButton#bomResetButton:pressed {
    background: #DCEEFF;
    border-color: #5A9DE6;
}

QPushButton#bomCompositionButton {
    min-height: 34px;
    background: #FFFFFF;
    border: 1px solid #D3E1F0;
    border-radius: 9px;
    padding: 0 14px;
    color: #315B8A;
    font-size: 12px;
    font-weight: 800;
}

QPushButton#bomCompositionButton:hover {
    background: #F2F7FD;
    border-color: #8CB8EA;
}

QPushButton#bomCompositionButton:checked {
    background: #EAF3FF;
    border-color: #5A9DE6;
    color: #176BC1;
}

QSplitter#SalineLeadSplitter::handle {
